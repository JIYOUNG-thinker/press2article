# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env는 깃허브에 올라가지 않습니다)

# 필수: 업스테이지 API 키 (up_로 시작)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxx

# Upstage Studio 워크플로우 → ⋯ → 코드 패널에서 확인
UPSTAGE_AGENT_ID=agt_xxxxxxxxxxxxxxxx     # Agent ID (agt_로 시작)
UPSTAGE_CONFIG_ID=                        # Config ID (비우면 최신 버전)
UPSTAGE_PROJECT_ID=proj_xxxxxxxxxxxxxxxx  # Project ID (proj_로 시작)

# 선택: Agent ID가 없을 때 쓸 Solar 모델 (일반 콘솔 키에서만 동작)
SOLAR_MODEL=solar-pro4
