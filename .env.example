# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env는 깃허브에 올라가지 않습니다)

# 필수: 업스테이지 콘솔(https://console.upstage.ai/api-keys)에서 받은 API 키 (up_로 시작)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxx

# 선택: Upstage Studio에서 만든 에이전트 ID. 넣으면 파일 첨부 시 Agents API로 실행됩니다.
UPSTAGE_AGENT_ID=

# 선택: 기사 작성에 쓸 Solar 모델 (기본 solar-pro4)
SOLAR_MODEL=solar-pro4
